# ============================================================================
# BRP MT5 Trade Router — Environment Configuration Template
# Copy to `.env` and fill in production values. Never commit real secrets.
# ============================================================================

# --- Database & Cache ---
DATABASE_URL=postgresql://user:password@localhost:5432/mt5_router
REDIS_URL=redis://localhost:6379

# --- Security & Authentication ---
JWT_SECRET=change-me-to-a-long-random-jwt-signing-secret
ENCRYPTION_KEY=change-me-32-byte-aes-256-key-here!!
SUPER_ADMIN_KEY=change-me-super-admin-bootstrap-key

# --- Server ---
PORT=5000
NODE_ENV=development
BACKEND_URL=https://your-backend-service.up.railway.app

# --- MT5 Manager API (source bridge) ---
MT5_MANAGER_LOGIN=10001
MT5_MANAGER_PASSWORD=your-mt5-manager-password
MT5_SERVER_ADDRESS=192.168.1.100:443

# --- FIX Liquidity Provider Connector ---
LP_FIX_SENDER_COMP_ID=BRP_SENDER
LP_FIX_TARGET_COMP_ID=LP_TARGET
LP_FIX_HOST=fix.lp-broker.com
LP_FIX_PORT=5001

# --- Billing / Alert Webhooks (optional) ---
BILLING_WEBHOOK_URL=https://hooks.example.com/billing-alerts
BILLING_ALERT_EMAIL=ops@yourbroker.com
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
