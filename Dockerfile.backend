# Production Railway image for the Express/WebSocket backend.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack install --global pnpm@9.15.9
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY mt-bridge/package.json mt-bridge/package.json
COPY shared/package.json shared/package.json
RUN pnpm install --frozen-lockfile
COPY tsconfig.base.json tsconfig.json ./
COPY backend backend
COPY mt-bridge mt-bridge
COPY shared shared
COPY scripts scripts
RUN pnpm --filter @workspace/backend build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack install --global pnpm@9.15.9
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml /app/.npmrc ./
COPY --from=build /app/backend/package.json backend/package.json
COPY --from=build /app/mt-bridge/package.json mt-bridge/package.json
COPY --from=build /app/shared/package.json shared/package.json
COPY --from=build /app/backend/dist backend/dist
COPY --from=build /app/backend/prisma backend/prisma
COPY --from=build /app/mt-bridge/dist mt-bridge/dist
COPY --from=build /app/shared/dist shared/dist
COPY --from=build /app/scripts/start-backend.mjs scripts/start-backend.mjs
RUN pnpm install --prod --frozen-lockfile
EXPOSE 5000
CMD ["node", "scripts/start-backend.mjs"]
