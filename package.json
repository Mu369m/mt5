{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run db:generate && pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm -r --parallel --filter @workspace/backend --filter @workspace/frontend run dev",
    "dev:backend": "pnpm --filter @workspace/backend run dev",
    "dev:frontend": "pnpm --filter @workspace/frontend run dev",
    "db:push": "pnpm --filter @workspace/backend run prisma:push",
    "db:generate": "pnpm --filter @workspace/backend run prisma:generate"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
